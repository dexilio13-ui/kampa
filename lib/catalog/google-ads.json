      "key": "impressions",
      "label": "Impressions",
      "description": "How many times your ad appeared on a screen.",
      "format": "number",
      "higherIsBetter": true,
      "levels": ["campaign", "ad_group", "ad", "keyword", "search_term", "product", "asset_group"],
      "sourceField": "metrics.impressions",
      "docUrl": "https://developers.google.com/google-ads/api/fields/v26/metrics#metrics.impressions",
      "group": "Performance"
    },
    {
      "key": "clicks",
      "label": "Clicks",
      "description": "How many times people clicked your ad.",
      "format": "number",
      "higherIsBetter": true,
      "levels": ["campaign", "ad_group", "ad", "keyword", "search_term", "product", "asset_group"],
      "sourceField": "metrics.clicks",
      "docUrl": "https://developers.google.com/google-ads/api/fields/v26/metrics#metrics.clicks",
      "group": "Performance"
    },
    {
      "key": "cost",
      "label": "Cost",
      "description": "How much you spent on this campaign, in the account's own currency.",
