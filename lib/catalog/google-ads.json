    { "key": "campaign", "label": "Campaigns", "description": "One row per campaign." },
    { "key": "ad_group", "label": "Ad groups", "description": "One row per ad group." },
    { "key": "ad", "label": "Ads", "description": "One row per ad." },
    { "key": "keyword", "label": "Keywords", "description": "One row per keyword." },
    { "key": "search_term", "label": "Search terms", "description": "One row per search term that triggered an ad." },
    { "key": "product", "label": "Products", "description": "One row per product in Shopping campaigns." },
    { "key": "asset_group", "label": "Asset groups", "description": "One row per Performance Max asset group." }
