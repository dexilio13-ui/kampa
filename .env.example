# AdPulse environment
# Copy to .env.local and fill in. Never use NEXT_PUBLIC_ for any secret.

# Required to encrypt data/settings.enc.json and sign the optional login cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Optional. When set, the app asks for this password before showing any data.
APP_PASSWORD=

# Optional overrides for the default API versions.
# GOOGLE_ADS_API_VERSION=v26
# META_API_VERSION=v26.0
# TIKTOK_API_VERSION=v1.3

# Optional: enable Meta asynchronous insights jobs (default off).
# META_ASYNC_ENABLED=true

# Optional: enable TikTok Commercial Content API (public Ad Library) live calls.
# Requires separate TikTok approval and a client token.
# TIKTOK_ADLIB_ENABLED=false

# Optional: store encrypted settings somewhere other than data/settings.enc.json.
# ADPULSE_SETTINGS_FILE=/absolute/path/to/settings.enc.json
